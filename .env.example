# Create these in .env.local and your deployment provider's environment settings.
IDX_BROKER_ACCESS_KEY=
# Required when IDX enables client-listing endpoints through a Development Partner.
IDX_BROKER_ANCILLARY_KEY=
# The approved IDX API listings endpoint for your account / MLS.
IDX_BROKER_LISTINGS_URL=
# 0 = always live API, or set to seconds (e.g. 3600 = one hour)
IDX_CACHE_SECONDS=0

# Follow Up Boss CRM Integration
FOLLOWUP_BOSS_API_KEY=

# Cloudflare Turnstile Spam Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
